# ==========================================
# Notion API Configuration
# ==========================================
# Notionのインテグレーションシークレット (例: secret_xxxx または ntn_xxxx)
NOTION_TOKEN=

# サンプルページツリーを作成する親ページのID (32文字のUUID、ハイフン有無どちらでも可)
NOTION_PARENT_PAGE_ID=

# ==========================================
# Confluence API Configuration
# ==========================================
# Confluence URL (例: https://your-domain.atlassian.net または https://your-domain.atlassian.net/wiki)
CONFLUENCE_URL=

# Atlassian アカウントのメールアドレス (例: user@example.com)
CONFLUENCE_USERNAME=

# Atlassian APIトークン (https://id.atlassian.com/manage-profile/security/api-tokens で生成)
CONFLUENCE_API_TOKEN=

# 移行先のConfluenceスペースキー (例: MIG, DEV, TEAM 等)
CONFLUENCE_SPACE_KEY=

# (任意) 移行先で親ページの下に階層を作成したい場合の親ページID (指定しない場合はスペース直下)
CONFLUENCE_PARENT_PAGE_ID=
